FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_API_ENDPOINT=/api/vision
ARG VITE_CARDS_API_ENDPOINT=/api/backend
ARG EXPO_PUBLIC_API_ENDPOINT=/api/vision
ARG EXPO_PUBLIC_CARDS_API_ENDPOINT=/api/backend
ARG VITE_GOOGLE_WEB_CLIENT_ID
ARG VITE_GOOGLE_IOS_CLIENT_ID
ARG VITE_GOOGLE_ANDROID_CLIENT_ID
ARG VITE_GOOGLE_WEB_REDIRECT_URI=http://localhost:8081/login
ARG EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
ARG EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
ARG EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID
ARG EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=http://localhost:8081/login
ENV VITE_API_ENDPOINT=${VITE_API_ENDPOINT}
ENV VITE_CARDS_API_ENDPOINT=${VITE_CARDS_API_ENDPOINT}
ENV EXPO_PUBLIC_API_ENDPOINT=${EXPO_PUBLIC_API_ENDPOINT}
ENV EXPO_PUBLIC_CARDS_API_ENDPOINT=${EXPO_PUBLIC_CARDS_API_ENDPOINT}
ENV VITE_GOOGLE_WEB_CLIENT_ID=${VITE_GOOGLE_WEB_CLIENT_ID}
ENV VITE_GOOGLE_IOS_CLIENT_ID=${VITE_GOOGLE_IOS_CLIENT_ID}
ENV VITE_GOOGLE_ANDROID_CLIENT_ID=${VITE_GOOGLE_ANDROID_CLIENT_ID}
ENV VITE_GOOGLE_WEB_REDIRECT_URI=${VITE_GOOGLE_WEB_REDIRECT_URI}
ENV EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID}
ENV EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID}
ENV EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID}
ENV EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=${EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx expo export --platform web --output-dir dist

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
